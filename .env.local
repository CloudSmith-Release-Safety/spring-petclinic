# Local Development Environment Configuration
# This file provides default values for local development
# Copy to .env and modify as needed

# Service URLs for local development
CUSTOMERS_SERVICE_URL=http://localhost:8081
VISITS_SERVICE_URL=http://localhost:8082
VETS_SERVICE_URL=http://localhost:8083

# Discovery and Config Server URLs
DISCOVERY_SERVER_URL=http://localhost:8761/eureka
CONFIG_SERVER_URL=http://localhost:8888/

# Database Configuration (if needed)
SPRING_DATASOURCE_URL=jdbc:h2:mem:testdb
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Logging Configuration
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SAMPLES_PETCLINIC=DEBUG
